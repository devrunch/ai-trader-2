NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://localhost:5432/aitrader
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

DATABASE_POOL_MAX=10

# Kite Connect (all five required in production)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Ops alerts (email only). Leave SMTP_URL unset to disable sending; alerts are then only logged.
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
APP_URL=http://localhost:5173
