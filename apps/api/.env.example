NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://localhost:5432/aitrader
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

DATABASE_POOL_MAX=10

# Kite Connect (all five required in production)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Email alerts. Resend (preferred): RESEND_API_KEY and RESEND_DOMAIN (verified in Resend); mail comes from alerts@<domain>.
# Or SMTP_URL. With neither, alerts are only logged. ALERT_EMAIL_TO receives them.
RESEND_API_KEY=
RESEND_DOMAIN=
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
APP_URL=http://localhost:5173

# Assistant model, any provider: AGENT_MODEL=provider/model. Unset disables the assistant cleanly.
#   bedrock-mantle/deepseek.v3.2      needs BEDROCK_API_KEY, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN); AWS_REGION (default ap-south-1)
#   anthropic/claude-sonnet-4-5       needs ANTHROPIC_API_KEY
#   xai/grok-4                        needs XAI_API_KEY
#   openai/gpt-5                      needs OPENAI_API_KEY
#   openai-compatible/<model id>      needs AGENT_BASE_URL + AGENT_API_KEY (OpenRouter, Together, a local vLLM or Ollama, ...)
AGENT_MODEL=
AGENT_FALLBACK_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
BEDROCK_API_KEY=
BEDROCK_BASE_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Per-turn ceilings and the per-user daily cap.
AGENT_MAX_ROUNDS=15
AGENT_TURN_TIMEOUT_MS=90000
AGENT_MAX_TOKENS=120000
AGENT_DAILY_TURNS=200

# News. Public RSS feeds need no key; NEWS_API_KEY (newsapi.org) adds global macro headlines.
NEWS_API_KEY=
