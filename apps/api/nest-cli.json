{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "modules/agent/prompts/**/*.md",
        "watchAssets": true
      },
      {
        "include": "modules/calendar/infrastructure/sources/*.json",
        "watchAssets": true
      }
    ]
  }
}
