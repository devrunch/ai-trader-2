{
  "name": "ai-trader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip",
    "jscpd": "jscpd",
    "diagrams:check": "node -e \"console.log('diagrams:check pending T-004')\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip && pnpm jscpd && pnpm diagrams:check && pnpm build"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.2",
    "jscpd": "5.4.3",
    "@vitest/coverage-v8": "5.1.0"
  }
}
