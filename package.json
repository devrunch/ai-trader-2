{
  "name": "ai-trader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/diagrams/tsconfig.json",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip",
    "jscpd": "jscpd",
    "diagrams:check": "node scripts/diagrams/check.ts",
    "check:code": "pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm test:int && pnpm depcruise && pnpm knip && pnpm jscpd && pnpm build",
    "check": "pnpm check:code && pnpm diagrams:validate && pnpm diagrams:check",
    "diagrams": "node scripts/diagrams/run.ts",
    "diagrams:serve": "likec4 serve architecture/model",
    "diagrams:build": "likec4 build architecture/model -o architecture/site",
    "diagrams:validate": "likec4 validate architecture/model",
    "test:int": "pnpm --filter @aitrader/api test:int",
    "build:packages": "pnpm --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.2",
    "jscpd": "5.4.3",
    "@vitest/coverage-v8": "5.1.0",
    "ts-morph": "28.0.0",
    "likec4": "1.60.0"
  }
}
